{
  "name": "spatial-audio-player",
  "version": "1.0.0",
  "description": "Universal head-tracked spatial audio player for Windows via OpenTrack (tested on Sony WF-1000XM5)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "desktop": "electron .",
    "desktop:dev": "electron .",
    "web": "node server.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "author": "alexander",
  "build": {
    "appId": "com.spatialaudio.player",
    "productName": "SpatialAudio",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "tools",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "index.html",
      "index.css",
      "server.js",
      "package.json"
    ]
  },
  "dependencies": {
    "express": "^4.21.0",
    "koffi": "^3.3.0",
    "three": "^0.186.0",
    "ws": "^8.18.0"
  },
  "keywords": [
    "spatial-audio",
    "head-tracking",
    "hrtf",
    "binaural",
    "opentrack",
    "sony"
  ],
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
